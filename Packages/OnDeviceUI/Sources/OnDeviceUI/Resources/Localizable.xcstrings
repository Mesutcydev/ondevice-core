        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं इन जोखिमों को समझता/समझती हूँ और इस मॉडल को एक बार आज़माना चाहता/चाहती हूँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのリスクを理解したうえで、このモデルを1回試したいです。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je comprends ces risques et je veux essayer ce modèle une fois."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entendo esses riscos e quero tentar este modelo uma vez."
