    "Downloaded files for this model will be removed. You can download it again later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heruntergeladenen Dateien dieses Modells werden entfernt. Du kannst es später erneut herunterladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán los archivos descargados de este modelo. Podrás descargarlo de nuevo."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف ملفات هذا النموذج المنزّلة. يمكنك تنزيله مجددًا لاحقًا."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu modelin indirilen dosyaları silinecek. Daha sonra yeniden indirebilirsiniz."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस मॉडल की डाउनलोड की गई फ़ाइलें हट जाएँगी। आप इसे बाद में फिर डाउनलोड कर सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモデルのダウンロード済みファイルを削除します。後で再ダウンロードできます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers téléchargés de ce modèle seront supprimés. Vous pourrez le télécharger à nouveau plus tard."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos baixados deste modelo serão removidos. Você pode baixá-lo novamente depois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file scaricati di questo modello verranno rimossi. Potrai scaricarlo di nuovo più tardi."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ληφθέντα αρχεία αυτού του μοντέλου θα αφαιρεθούν. Μπορείτε να το κατεβάσετε ξανά αργότερα."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișierele descărcate ale acestui model vor fi eliminate. Îl puteți descărca din nou mai târziu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачанные файлы этой модели будут удалены. Позже её можно скачать снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
