    "Cancelled files and resumable transfer cache · %@. Paused downloads may restart." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgebrochene Dateien und fortsetzbarer Übertragungscache · %@. Pausierte Downloads starten eventuell neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos cancelados y caché de transferencias reanudables · %@. Las descargas en pausa podrían reiniciarse."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفات ملغاة وذاكرة تخزين مؤقت للنقل القابل للاستئناف · %@. قد تبدأ التنزيلات المتوقفة مؤقتًا من جديد."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İptal edilen dosyalar ve devam ettirilebilir aktarım önbelleği · %@. Duraklatılan indirmeler yeniden başlayabilir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रद्द की गई फ़ाइलें और फिर शुरू होने लायक ट्रांसफ़र कैश · %@। रोके गए डाउनलोड फिर से शुरू हो सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセルされたファイルと再開可能な転送キャッシュ · %@。一時停止中のダウンロードは最初からやり直しになる場合があります。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers annulés et cache de transferts reprenables · %@. Les téléchargements en pause peuvent repartir de zéro."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos cancelados e cache de transferências retomáveis · %@. Downloads pausados podem recomeçar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File annullati e cache dei trasferimenti riprendibili · %@. I download in pausa potrebbero ripartire da capo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακυρωμένα αρχεία και προσωρινή μνήμη μεταφορών με δυνατότητα συνέχισης · %@. Οι λήψεις σε παύση μπορεί να ξεκινήσουν από την αρχή."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișiere anulate și cache de transferuri reluabile · %@. Descărcările suspendate pot reîncepe de la zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменённые файлы и кэш возобновляемых передач · %@. Приостановленные загрузки могут начаться заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已取消的文件和可恢复传输的缓存 · %@。已暂停的下载可能需要重新开始。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소된 파일과 이어받기 가능한 전송 캐시 · %@. 일시 중지된 다운로드는 처음부터 다시 시작될 수 있습니다."
          }
        }
      },
      "generatesSymbol" : false
    },
