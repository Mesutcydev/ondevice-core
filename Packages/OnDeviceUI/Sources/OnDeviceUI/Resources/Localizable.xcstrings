    "Off uses the app-wide Assistant settings. Turn it on to save an independent profile for this model." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus verwendet die allgemeinen Assistenteneinstellungen. Aktiviere die Option für ein eigenes Modellprofil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado usa los ajustes generales del asistente. Actívalo para guardar un perfil independiente del modelo."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التعطيل تُستخدم إعدادات المساعد العامة. فعّله لحفظ ملف مستقل لهذا النموذج."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken genel Asistan ayarları kullanılır. Bu modele özel profil kaydetmek için açın."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद होने पर ऐप के सामान्य सहायक सेटिंग उपयोग होते हैं। मॉडल की स्वतंत्र प्रोफ़ाइल सहेजने के लिए चालू करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフではアシスタントの共通設定を使います。オンにするとモデル専用のプロファイルを保存できます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé utilise les réglages de l'Assistant pour toute l'app. Activez l'option pour enregistrer un profil indépendant pour ce modèle."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado usa os ajustes do Assistente para todo o app. Ative para salvar um perfil independente para este modelo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato usa le impostazioni dell'Assistente valide per tutta l'app. Attiva l'opzione per salvare un profilo indipendente per questo modello."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «Ανενεργό» χρησιμοποιεί τις γενικές ρυθμίσεις του Βοηθού. Ενεργοποιήστε το για να αποθηκεύσετε ανεξάρτητο προφίλ για αυτό το μοντέλο."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivat folosește setările Asistentului pentru întreaga aplicație. Activați pentru a salva un profil independent pentru acest model."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Выкл.» использует общие настройки Ассистента. Включите, чтобы сохранить отдельный профиль для этой модели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“关”使用应用全局的助手设置。打开后可为此模型存储独立的配置。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔은 앱 전체 어시스턴트 설정을 사용합니다. 켜면 이 모델의 독립 프로필을 저장합니다."
          }
        }
      },
      "generatesSymbol" : false
    },
