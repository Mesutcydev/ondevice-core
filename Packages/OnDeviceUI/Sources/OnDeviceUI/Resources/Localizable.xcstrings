    "These excerpts were supplied to the model for this reply. They are saved snapshots; review them to check the answer." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Auszüge wurden dem Modell für die Antwort übergeben. Prüfe die gespeicherten Ausschnitte, um die Antwort zu kontrollieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos extractos se facilitaron al modelo para responder. Son copias guardadas; revísalas para comprobar la respuesta."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُرسلت هذه المقتطفات للنموذج لهذا الرد. هي لقطات محفوظة؛ راجعها للتحقق من الإجابة."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu alıntılar bu yanıt için modele verildi. Kayıtlı görüntülerdir; yanıtı denetlemek için inceleyin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये अंश इस जवाब के लिए मॉडल को दिए गए थे। ये सहेजी गई प्रतियाँ हैं; जवाब जाँचने के लिए समीक्षा करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この回答のためモデルに提供した抜粋です。保存済みの内容を確認して回答を検証できます。"
          }
        }
      },
      "generatesSymbol" : false
    },
    "These values apply only to the next message. Empty controls use the selected model’s saved profile or the app defaults." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Werte gelten nur für die nächste Nachricht. Leere Felder verwenden das gespeicherte Modellprofil oder die App-Standards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos valores solo se aplican al siguiente mensaje. Los campos vacíos usan el perfil del modelo o los valores de la app."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنطبق هذه القيم على الرسالة التالية فقط. تستخدم الحقول الفارغة ملف النموذج المحفوظ أو إعدادات التطبيق الافتراضية."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu değerler yalnızca sonraki mesaj için geçerlidir. Boş alanlar modelin kayıtlı profilini veya uygulama varsayılanlarını kullanır."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये मान केवल अगले संदेश पर लागू हैं। खाली नियंत्रण मॉडल की सहेजी प्रोफ़ाइल या ऐप डिफ़ॉल्ट उपयोग करते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のメッセージにのみ適用します。空欄はモデルの保存済みプロファイルまたはアプリの初期値を使います。"
          }
        }
      },
      "generatesSymbol" : false
    },
