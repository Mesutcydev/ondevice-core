          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test audio. Dacă auziți asta, vor fi redate răspunsurile vocale."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختبار الصوت. إذا سمعت هذا، فسيتم تشغيل الردود الصوتية."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 테스트. 이것이 들리면 음성 응답이 재생됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频测试。如果您听到此消息，语音回复将会播放。"
          }
        }
      },
      "generatesSymbol" : false
    },
