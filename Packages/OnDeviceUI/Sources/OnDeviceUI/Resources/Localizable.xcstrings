    "The assistant will stop grounding answers in them. You'd need to import the files again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Assistent stützt seine Antworten dann nicht mehr darauf. Du müsstest die Dateien erneut importieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente dejará de basar sus respuestas en ellos. Tendrías que volver a importar los archivos."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف المساعد عن بناء إجاباته عليها. ستحتاج إلى استيراد الملفات مرة أخرى."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistan yanıtlarını artık bunlara dayandırmaz. Dosyaları yeniden içe aktarmanız gerekir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहायक अब इनके आधार पर उत्तर नहीं देगा। आपको फ़ाइलें फिर से आयात करनी होंगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アシスタントはこれらを根拠に回答しなくなります。もう一度ファイルを読み込む必要があります。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistant ne fondera plus ses réponses sur eux. Vous devrez importer de nouveau les fichiers."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O assistente deixará de basear as respostas neles. Você precisaria importar os arquivos novamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistente non baserà più le risposte su di essi. Dovresti importare di nuovo i file."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο βοηθός θα σταματήσει να βασίζει τις απαντήσεις σε αυτά. Θα χρειαστεί να εισαγάγετε ξανά τα αρχεία."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistentul nu va mai baza răspunsurile pe ele. Ar trebui să importați din nou fișierele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ассистент перестанет опираться на них в ответах. Файлы придётся импортировать снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "助手将不再依据它们来回答。你需要重新导入这些文件。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어시스턴트가 더 이상 이 문서를 근거로 답변하지 않습니다. 파일을 다시 가져와야 합니다."
          }
        }
      },
      "generatesSymbol" : false
    },
