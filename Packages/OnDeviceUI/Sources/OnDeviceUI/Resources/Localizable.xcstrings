    "Audio test. If you hear this, voice replies will play." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses testi. Bunu duyuyorsanız sesli yanıtlar çalacak."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audiotest. Wenn Sie dies hören, werden Sprachantworten abgespielt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test audio. Si vous entendez ceci, les réponses vocales seront diffusées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba de audio. Si escucha esto, las respuestas de voz se reproducirán."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test audio. Se senti questo, le risposte vocali verranno riprodotte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teste de áudio. Se você ouvir isto, as respostas de voz serão reproduzidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест звука. Если вы это слышите, голосовые ответы будут воспроизводиться."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑडियो परीक्षण। यदि आप यह सुनते हैं, तो आवाज़ उत्तर चलेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
