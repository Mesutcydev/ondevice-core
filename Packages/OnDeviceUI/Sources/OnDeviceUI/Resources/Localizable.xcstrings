    "Pause keeps your progress. Cancel removes the partial download." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausieren behält den Fortschritt. Abbrechen entfernt den bisherigen Download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar conserva el progreso. Cancelar elimina la descarga parcial."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإيقاف المؤقت يحفظ التقدم. الإلغاء يحذف التنزيل الجزئي."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatmak ilerlemenizi korur. İptal etmek kısmi indirmeyi siler."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोकने पर प्रगति बनी रहती है। रद्द करने पर अधूरा डाउनलोड हट जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止すると進捗を保持します。キャンセルするとダウンロード途中のファイルを削除します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pause conserve votre progression. L'annulation supprime le téléchargement partiel."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar mantém seu progresso. Cancelar remove o download parcial."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pausa conserva i progressi. L'annullamento rimuove il download parziale."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η παύση διατηρεί την πρόοδό σας. Η ακύρωση αφαιρεί τη μερική λήψη."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauza vă păstrează progresul. Anularea elimină descărcarea parțială."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пауза сохраняет прогресс. Отмена удаляет частичную загрузку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停会保留进度。取消会移除未完成的下载。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 중지하면 진행 상황이 유지됩니다. 취소하면 일부 받은 다운로드가 제거됩니다."
          }
        }
      },
      "generatesSymbol" : false
    },
