    "We noticed you use the camera — getting weights ready so capture is instant." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerayı sık kullandığınızı fark ettik — çekim anlık olsun diye ağırlıklar hazırlanıyor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben bemerkt, dass Sie die Kamera verwenden — Gewichte werden vorbereitet, damit die Aufnahme sofort erfolgt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons remarqué que vous utilisez la caméra — préparation des poids pour une capture instantanée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notamos que usa la cámara — preparando pesos para que la captura sea instantánea."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo notato che usi la fotocamera — preparazione pesi per un'acquisizione immediata."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percebemos que você usa a câmera — preparando pesos para que a captura seja instantânea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы заметили, что вы используете камеру — готовим веса для мгновенного снимка."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमने देखा कि आप कैमरा उपयोग करते हैं — वेट तैयार किए जा रहे हैं ताकि कैप्चर तुरंत हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラの使用を検知しました — キャプチャが即時になるよう重みを準備中。"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρατηρήσαμε ότι χρησιμοποιείτε την κάμερα — ετοιμάζετε τα βάρη, ώστε η λήψη να είναι άμεση."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am observat că folosești camera — pregătirea greutăților, astfel încât capturarea să fie instantanee."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لاحظنا أنك تستخدم الكاميرا — تجهيز الأوزان ليكون الالتقاط فوريًا."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
