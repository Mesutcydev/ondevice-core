    "Chat, read what’s around you, and create with models on your device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatte, erfasse deine Umgebung und gestalte mit Modellen auf deinem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversa, lee lo que te rodea y crea con modelos en tu dispositivo."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدث واقرأ ما حولك وأنشئ باستخدام النماذج على جهازك."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazınızdaki modellerle sohbet edin, çevrenizi okuyun ve üretin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने डिवाइस के मॉडल से चैट करें, आसपास पढ़ें और बनाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上のモデルで会話し、周囲の情報を読み取り、作品を作れます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discutez, lisez ce qui vous entoure et créez avec des modèles sur votre appareil."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converse, leia o que está ao seu redor e crie com modelos no seu dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatta, leggi ciò che ti circonda e crea con i modelli sul tuo dispositivo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συζητήστε, διαβάστε ό,τι βρίσκεται γύρω σας και δημιουργήστε με μοντέλα στη συσκευή σας."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discutați, citiți ce vă înconjoară și creați cu modele de pe dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общайтесь, читайте окружающий мир и создавайте с моделями на вашем устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用设备上的模型聊天、读懂周围事物并进行创作。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기의 모델로 대화하고, 주변을 읽고, 창작하세요."
          }
        }
      },
      "generatesSymbol" : false
    },
    "Chat, see, speak and create with models that run on your iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
