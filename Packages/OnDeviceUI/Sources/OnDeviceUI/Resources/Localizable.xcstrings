    "These commands use localhost for this device. Connect to Wi-Fi to get an address for another device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Befehle nutzen localhost für dieses Gerät. Verbinde dich mit WLAN, um eine Adresse für ein anderes Gerät zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos comandos usan localhost para este dispositivo. Conéctate a Wi-Fi para obtener una dirección para otro dispositivo."
