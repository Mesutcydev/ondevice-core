    "Token AI" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "shouldTranslate" : false
    },
    "Token AI combines local models with optional API providers, web access, Apple Private Cloud Compute, and paired Mac tools. Each network feature is controlled separately." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI kombiniert lokale Modelle mit optionalen API-Anbietern, Webzugriff, Apple Private Cloud Compute und gekoppelten Mac-Werkzeugen. Jede Netzwerkfunktion wird einzeln gesteuert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI combina modelos locales con proveedores API opcionales, acceso web, Apple Private Cloud Compute y herramientas de Mac enlazadas. Cada función de red se controla por separado."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع Token AI بين النماذج المحلية ومزوّدي API الاختياريين والوصول للويب وApple Private Cloud Compute وأدوات Mac المقترنة. يمكن التحكم بكل ميزة شبكة على حدة."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI; yerel modelleri, isteğe bağlı API sağlayıcıları, web erişimi, Apple Private Cloud Compute ve eşlenmiş Mac araçlarıyla birleştirir. Her ağ özelliği ayrı yönetilir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI स्थानीय मॉडल के साथ वैकल्पिक API प्रदाता, वेब एक्सेस, Apple Private Cloud Compute और जुड़े Mac टूल जोड़ता है। हर नेटवर्क सुविधा अलग नियंत्रित होती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AIはローカルモデルに加え、任意のAPIプロバイダー、ウェブアクセス、Apple Private Cloud Compute、ペアリングしたMacのツールに対応します。各ネットワーク機能は個別に管理できます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI associe des modèles locaux à des fournisseurs d'API facultatifs, à l'accès web, à Apple Private Cloud Compute et aux outils Mac jumelés. Chaque fonctionnalité réseau se contrôle séparément."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Token AI combina modelos locais com provedores de API opcionais, acesso à web, Apple Private Cloud Compute e ferramentas do Mac pareado. Cada recurso de rede é controlado separadamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI combina modelli locali con provider API facoltativi, accesso web, Apple Private Cloud Compute e strumenti del Mac abbinato. Ogni funzione di rete si controlla separatamente."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Token AI συνδυάζει τοπικά μοντέλα με προαιρετικούς παρόχους API, πρόσβαση στον ιστό, Apple Private Cloud Compute και εργαλεία ζευγοποιημένου Mac. Κάθε λειτουργία δικτύου ελέγχεται ξεχωριστά."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI combină modele locale cu furnizori API opționali, acces web, Apple Private Cloud Compute și instrumente Mac asociate. Fiecare funcție de rețea se controlează separat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI сочетает локальные модели с необязательными провайдерами API, веб-доступом, Apple Private Cloud Compute и инструментами сопряжённого Mac. Каждая сетевая функция управляется отдельно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI 将本地模型与可选的 API 提供商、联网访问、Apple Private Cloud Compute 和已配对的 Mac 工具结合起来。每项网络功能都可单独控制。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI는 로컬 모델에 선택적 API 제공업체, 웹 접근, Apple Private Cloud Compute, 페어링된 Mac 도구를 결합합니다. 각 네트워크 기능은 따로 제어됩니다."
          }
        }
      },
      "generatesSymbol" : false
    },
