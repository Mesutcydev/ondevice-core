    "Everything starts selected. Untick the models you no longer need, or choose Active only to keep just the ones in use." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu Beginn ist alles ausgewählt. Hake Modelle ab, die du nicht mehr brauchst, oder wähle „Nur aktive“, um nur die verwendeten zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al empezar, todo está seleccionado. Desmarca los modelos que ya no necesites o elige Solo activos para conservar únicamente los que usas."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ كل شيء محددًا. ألغِ تحديد النماذج التي لم تعد بحاجة إليها، أو اختر «النشطة فقط» لإبقاء المستخدمة منها فقط."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlangıçta her şey seçilidir. Artık ihtiyaç duymadığınız modellerin işaretini kaldırın ya da yalnızca kullanımda olanları saklamak için Yalnızca etkin olanlar'ı seçin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरुआत में सब कुछ चुना हुआ होता है। जिन मॉडल की अब ज़रूरत नहीं, उनका चयन हटाएँ, या केवल उपयोग में आने वाले मॉडल रखने के लिए “केवल सक्रिय” चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初はすべて選択されています。不要なモデルの選択を外すか、「使用中のみ」を選んで使用中のモデルだけを残してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est sélectionné au départ. Décochez les modèles dont vous n'avez plus besoin, ou choisissez Actifs uniquement pour ne garder que ceux en cours d'utilisation."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo começa selecionado. Desmarque os modelos de que você não precisa mais ou escolha Somente ativos para manter apenas os que estão em uso."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All'inizio è tutto selezionato. Deseleziona i modelli che non ti servono più oppure scegli Solo attivi per mantenere solo quelli in uso."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρχικά όλα είναι επιλεγμένα. Αποεπιλέξτε τα μοντέλα που δεν χρειάζεστε πια ή επιλέξτε Μόνο ενεργά για να κρατήσετε μόνο όσα χρησιμοποιούνται."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La început, totul este selectat. Debifați modelele de care nu mai aveți nevoie sau alegeți Doar active pentru a păstra doar modelele folosite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала выбрано всё. Снимите отметку с моделей, которые больше не нужны, или выберите «Только активные», чтобы оставить лишь используемые."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始时全部已选中。取消勾选不再需要的模型，或选择“仅活跃”，只保留正在使用的模型。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음에는 모든 항목이 선택되어 있습니다. 더 이상 필요 없는 모델의 선택을 해제하거나, ‘사용 중만’을 선택해 사용 중인 모델만 유지하세요."
          }
        }
      },
      "generatesSymbol" : false
    },
    "%lld kept" : {
