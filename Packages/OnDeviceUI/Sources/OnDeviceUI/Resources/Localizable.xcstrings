        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies gibt Speicherplatz frei. Das Modell kann später erneut heruntergeladen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela libère de l'espace disque. Le modèle peut être téléchargé à nouveau plus tard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
