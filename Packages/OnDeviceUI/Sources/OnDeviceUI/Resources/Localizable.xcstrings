    "Install LocalCoderBridge on your Mac to share Xcode context, run builds, and use Argent to drive the iOS simulator from this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazdan Xcode bağlamını paylaşmak, derlemeleri çalıştırmak ve Argent ile iOS simülatörünü sürmek için Mac'inize LocalCoderBridge'i yükleyin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installieren Sie LocalCoderBridge auf Ihrem Mac, um Xcode-Kontext zu teilen, Builds auszuführen und Argent zu verwenden, um den iOS-Simulator von diesem Gerät aus zu steuern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez LocalCoderBridge sur votre Mac pour partager le contexte Xcode, exécuter des builds et utiliser Argent pour piloter le simulateur iOS depuis cet appareil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale LocalCoderBridge en su Mac para compartir el contexto de Xcode, ejecutar compilaciones y usar Argent para controlar el simulador de iOS desde este dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa LocalCoderBridge sul tuo Mac per condividere il contesto Xcode, eseguire build e usare Argent per controllare il simulatore iOS da questo dispositivo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale o LocalCoderBridge no seu Mac para compartilhar o contexto do Xcode, executar builds e usar o Argent para controlar o simulador iOS deste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите LocalCoderBridge на ваш Mac для обмена контекстом Xcode, запуска сборок и управления симулятором iOS с этого устройства через Argent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode संदर्भ साझा करने, बिल्ड चलाने और इस डिवाइस से iOS सिम्युलेटर चलाने के लिए अपने Mac पर LocalCoderBridge इंस्टॉल करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalCoderBridgeをMacにインストールして、Xcodeコンテキストの共有、ビルドの実行、ArgentによるiOSシミュレータの操作が可能です。"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγκαταστήστε το LocalCoderBridge στο Mac σας για να μοιραστείτε το περιβάλλον Xcode, να εκτελέσετε εκδόσεις και να χρησιμοποιήσετε το Argent για να οδηγήσετε τον προσομοιωτή iOS από αυτήν τη συσκευή."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalați LocalCoderBridge pe Mac pentru a partaja contextul Xcode, a rula versiuni și a utiliza Argent pentru a conduce simulatorul iOS de pe acest dispozitiv."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبت LocalCoderBridge على جهاز Mac لمشاركة سياق Xcode وتشغيل البناء واستخدام Argent لتشغيل محاكي iOS من هذا الجهاز."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalCoderBridge를 Mac에 설치하여 Xcode 컨텍스트 공유, 빌드 실행, Argent로 이 기기에서 iOS 시뮬레이터 구동."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Mac 上安装 LocalCoderBridge，以共享 Xcode 上下文、运行构建，并使用 Argent 从此设备驱动 iOS 模拟器。"
          }
        }
      },
      "generatesSymbol" : false
