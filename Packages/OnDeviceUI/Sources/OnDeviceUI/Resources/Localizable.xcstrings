        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजा टोकन हटता है और GitHub टूल बंद होते हैं। रिपॉज़िटरी ड्राफ़्ट अपनी चैट में रहते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
