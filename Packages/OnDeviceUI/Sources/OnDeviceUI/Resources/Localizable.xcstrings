    "Advanced values apply only to the next message. Untouched controls use the model’s saved profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterte Werte gelten nur für die nächste Nachricht. Unveränderte Felder nutzen das gespeicherte Modellprofil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores avanzados solo se aplican al siguiente mensaje. Los controles sin cambiar usan el perfil del modelo."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنطبق القيم المتقدمة على الرسالة التالية فقط. تستخدم الإعدادات غير المعدلة ملف النموذج المحفوظ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelişmiş değerler yalnızca sonraki mesaj için geçerlidir. Dokunulmayan denetimler modelin kayıtlı profilini kullanır."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन्नत मान केवल अगले संदेश पर लागू हैं। अपरिवर्तित नियंत्रण मॉडल की सहेजी प्रोफ़ाइल उपयोग करते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高度な設定は次のメッセージにのみ適用します。未変更の項目はモデルの保存済みプロファイルを使います。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs avancées ne s'appliquent qu'au prochain message. Les réglages non modifiés utilisent le profil enregistré du modèle."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores avançados valem apenas para a próxima mensagem. Controles não alterados usam o perfil salvo do modelo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori avanzati valgono solo per il prossimo messaggio. I controlli non modificati usano il profilo salvato del modello."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι προηγμένες τιμές ισχύουν μόνο για το επόμενο μήνυμα. Όσα στοιχεία δεν αλλάξατε χρησιμοποιούν το αποθηκευμένο προφίλ του μοντέλου."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valorile avansate se aplică doar următorului mesaj. Comenzile nemodificate folosesc profilul salvat al modelului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расширенные значения действуют только для следующего сообщения. Неизменённые параметры берутся из сохранённого профиля модели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
