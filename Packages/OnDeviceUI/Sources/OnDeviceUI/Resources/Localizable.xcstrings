    "More steps take longer. Turbo models usually need only a few." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Schritte dauern länger. Turbo-Modelle benötigen meist nur wenige."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más pasos tardan más. Los modelos Turbo suelen necesitar pocos."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخطوات الأكثر تستغرق وقتًا أطول. نماذج Turbo تحتاج عادةً خطوات قليلة."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha fazla adım daha uzun sürer. Turbo modeller genellikle az adım gerektirir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिक चरणों में अधिक समय लगता है। Turbo मॉडल को आम तौर पर कुछ ही चरण चाहिए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステップ数が多いほど時間がかかります。Turboモデルは通常、少数のステップで動作します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus d'étapes prennent plus de temps. Les modèles Turbo n'en nécessitent généralement que quelques-unes."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais etapas levam mais tempo. Modelos Turbo geralmente precisam de poucas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più passaggi richiedono più tempo. Ai modelli Turbo di solito ne bastano pochi."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα περισσότερα βήματα παίρνουν περισσότερο χρόνο. Τα μοντέλα Turbo χρειάζονται συνήθως μόνο λίγα."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai mulți pași durează mai mult. Modelele Turbo au nevoie de obicei doar de câțiva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем больше шагов, тем дольше. Turbo-моделям обычно хватает нескольких."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
