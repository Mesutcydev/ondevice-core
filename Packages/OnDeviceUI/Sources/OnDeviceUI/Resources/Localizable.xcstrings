    "%@ reads images through %@, which runs on this device. The image stays attached; send it again when the download finishes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liest Bilder über %@, das auf diesem Gerät läuft. Das Bild bleibt angehängt; sende es erneut, wenn der Download fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lee imágenes a través de %@, que se ejecuta en este dispositivo. La imagen sigue adjunta; vuelve a enviarla cuando termine la descarga."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ %@ الصور عبر %@ الذي يعمل على هذا الجهاز. تبقى الصورة مرفقة؛ أعد إرسالها عند انتهاء التنزيل."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ görselleri bu cihazda çalışan %@ üzerinden okur. Görsel ekli kalır; indirme bitince yeniden gönderin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इमेज को %@ के ज़रिए पढ़ता है, जो इसी डिवाइस पर चलता है। इमेज संलग्न रहती है; डाउनलोड पूरा होने पर इसे फिर से भेजें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は、このデバイスで動作する%@を通して画像を読み取ります。画像は添付されたままです。ダウンロードが終わったらもう一度送信してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lit les images via %@, qui s'exécute sur cet appareil. L'image reste jointe ; renvoyez-la lorsque le téléchargement est terminé."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lê imagens por meio de %@, que roda neste dispositivo. A imagem continua anexada; envie-a novamente quando o download terminar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ legge le immagini tramite %@, che viene eseguito su questo dispositivo. L'immagine resta allegata; inviala di nuovo al termine del download."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ διαβάζει εικόνες μέσω του %@, που τρέχει σε αυτήν τη συσκευή. Η εικόνα παραμένει συνημμένη· στείλτε την ξανά όταν ολοκληρωθεί η λήψη."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ citește imaginile prin %@, care rulează pe acest dispozitiv. Imaginea rămâne atașată; trimiteți-o din nou când se termină descărcarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ читает изображения через %@, которая работает на этом устройстве. Изображение остаётся прикреплённым; отправьте его снова после завершения скачивания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 通过在此设备上运行的 %@ 读取图片。图片仍保持附加；下载完成后请重新发送。"
          }
        },
        "ko" : {
          "stringUnit" : {
