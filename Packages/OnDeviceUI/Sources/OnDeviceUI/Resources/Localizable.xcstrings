    "Tap to use a model and remember it for new chats. The star saves a default without loading it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe zum Verwenden und Merken für neue Chats. Der Stern speichert den Standard, ohne das Modell zu laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para usar un modelo en chats nuevos. La estrella guarda el predeterminado sin cargarlo."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط لاستخدام نموذج وتذكّره للمحادثات الجديدة. تحفظ النجمة النموذج الافتراضي دون تحميله."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir modeli kullanmak ve yeni sohbetler için hatırlamak üzere dokunun. Yıldız, modeli yüklemeden varsayılanı kaydeder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मॉडल उपयोग करने और नई चैट के लिए याद रखने को टैप करें। तारा उसे लोड किए बिना डिफ़ॉल्ट सहेजता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルを使い、新しいチャット用に記憶するにはタップします。星は読み込まずにデフォルトとして保存します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour utiliser un modèle et le mémoriser pour les nouvelles discussions. L'étoile enregistre un modèle par défaut sans le charger."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para usar um modelo e lembrá-lo em novos chats. A estrela salva um padrão sem carregá-lo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per usare un modello e ricordarlo per le nuove chat. La stella salva un modello predefinito senza caricarlo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε για να χρησιμοποιήσετε ένα μοντέλο και να το θυμάται η εφαρμογή για νέες συζητήσεις. Το αστέρι αποθηκεύει μια προεπιλογή χωρίς να τη φορτώσει."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingeți pentru a folosi un model și a-l reține pentru chaturile noi. Steaua salvează un model implicit fără a-l încărca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите, чтобы использовать модель и запомнить её для новых чатов. Звезда сохраняет модель по умолчанию, не загружая её."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点即可使用模型，并在新聊天中记住它。星标可存储默认模型而不加载。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭하면 모델을 사용하고 새 채팅에 기억합니다. 별표는 모델을 로드하지 않고 기본값으로 저장합니다."
          }
        }
      },
      "generatesSymbol" : false
    },
