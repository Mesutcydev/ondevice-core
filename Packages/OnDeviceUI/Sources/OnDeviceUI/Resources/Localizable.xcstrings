        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест звука. Если вы это слышите, голосовые ответы будут воспроизводиться."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑडियो परीक्षण। यदि आप यह सुनते हैं, तो आवाज़ उत्तर चलेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
