    "%@ needs the shared model or microphone. Your voice conversation will end before continuing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ benötigt das gemeinsame Modell oder Mikrofon. Deine Sprachunterhaltung wird vor dem Fortfahren beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita el modelo o micrófono compartido. La conversación por voz terminará antes de continuar."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب %@ النموذج أو الميكروفون المشترك. ستنتهي المحادثة الصوتية قبل المتابعة."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ paylaşılan modeli veya mikrofonu gerektirir. Devam etmeden önce sesli sohbetiniz bitecek."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को साझा मॉडल या माइक्रोफ़ोन चाहिए। जारी रखने से पहले आपकी आवाज़ से बातचीत समाप्त होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には共有モデルまたはマイクが必要です。続行前に音声会話を終了します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a besoin du modèle partagé ou du microphone. Votre conversation vocale prendra fin avant de continuer."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ precisa do modelo compartilhado ou do microfone. Sua conversa por voz será encerrada antes de continuar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ richiede il modello condiviso o il microfono. La conversazione vocale terminerà prima di continuare."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ χρειάζεται το κοινόχρηστο μοντέλο ή το μικρόφωνο. Η φωνητική συνομιλία σας θα τερματιστεί πριν συνεχίσετε."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ are nevoie de modelul partajat sau de microfon. Conversația vocală se va încheia înainte de a continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для «%@» нужна общая модель или микрофон. Голосовой разговор завершится перед продолжением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@需要使用共享模型或麦克风。继续之前将结束你的语音对话。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 공유 모델 또는 마이크가 필요합니다. 계속하기 전에 음성 대화가 종료됩니다."
          }
        }
      },
      "generatesSymbol" : false
    },
