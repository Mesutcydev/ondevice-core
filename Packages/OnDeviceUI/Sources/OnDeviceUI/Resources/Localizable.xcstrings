    "%@ needs the shared model or microphone. Your voice conversation will end before continuing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ benötigt das gemeinsame Modell oder Mikrofon. Deine Sprachunterhaltung wird vor dem Fortfahren beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita el modelo o micrófono compartido. La conversación por voz terminará antes de continuar."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب %@ النموذج أو الميكروفون المشترك. ستنتهي المحادثة الصوتية قبل المتابعة."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ paylaşılan modeli veya mikrofonu gerektirir. Devam etmeden önce sesli sohbetiniz bitecek."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को साझा मॉडल या माइक्रोफ़ोन चाहिए। जारी रखने से पहले आपकी आवाज़ से बातचीत समाप्त होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には共有モデルまたはマイクが必要です。続行前に音声会話を終了します。"
          }
        }
      },
      "generatesSymbol" : false
    },
    "%@ s · On device" : {
