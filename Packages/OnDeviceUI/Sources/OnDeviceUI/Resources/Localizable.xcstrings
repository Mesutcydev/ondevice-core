    "Comments on what the camera sees until you stop" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommentiert, was die Kamera sieht, bis du stoppst"
