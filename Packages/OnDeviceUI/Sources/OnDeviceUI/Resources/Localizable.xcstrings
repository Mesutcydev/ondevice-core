    "The assistant grounds replies in your files and cites them — fully offline." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Assistent stützt Antworten auf deine Dateien und zitiert sie – komplett offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente basa sus respuestas en tus archivos y los cita, totalmente sin conexión."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبني المساعد إجاباته على ملفاتك ويستشهد بها، دون اتصال بالكامل."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistan yanıtları dosyalarınıza dayandırır ve bunlara atıf yapar; tamamen çevrimdışı."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहायक आपकी फ़ाइलों के आधार पर उत्तर देता है और उनका हवाला देता है — पूरी तरह ऑफ़लाइन।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アシスタントはあなたのファイルを根拠に回答し、出典も示します。完全にオフラインで動作します。"
          }
        },
        "fr" : {
          "stringUnit" : {
