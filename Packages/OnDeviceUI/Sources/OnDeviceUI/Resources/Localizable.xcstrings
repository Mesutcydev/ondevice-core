    "This deletes the saved token and turns off GitHub tools. Repository drafts remain in their chats." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht den gespeicherten Token und deaktiviert GitHub-Werkzeuge. Repository-Entwürfe bleiben in den Chats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina el token y desactiva las herramientas de GitHub. Los borradores del repositorio permanecen en los chats."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف الرمز المحفوظ ويعطّل أدوات GitHub. تبقى مسودات المستودع في محادثاتها."
