    "This device's language doesn't have a local embedding model, so the Knowledge Base can't index text here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Sprache dieses Geräts gibt es kein lokales Einbettungsmodell, daher kann die Wissensbasis hier keinen Text indizieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma de este dispositivo no tiene un modelo de incrustaciones local, así que la base de conocimiento no puede indexar texto aquí."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتوفر لغة هذا الجهاز نموذج تضمين محلي، لذا لا يمكن لقاعدة المعرفة فهرسة النص هنا."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazın dilinde yerel bir gömme modeli yok, bu yüzden Bilgi Tabanı burada metni dizinleyemiyor."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस की भाषा के लिए कोई स्थानीय एम्बेडिंग मॉडल नहीं है, इसलिए ज्ञान आधार यहाँ टेक्स्ट को इंडेक्स नहीं कर सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの言語にはローカルの埋め込みモデルがないため、ナレッジベースはここでテキストを索引化できません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue de cet appareil n'a pas de modèle d'embeddings local, donc la base de connaissances ne peut pas indexer de texte ici."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma deste dispositivo não tem um modelo de embeddings local, então a base de conhecimento não pode indexar texto aqui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lingua di questo dispositivo non ha un modello di embedding locale, quindi la base di conoscenza non può indicizzare il testo qui."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η γλώσσα αυτής της συσκευής δεν έχει τοπικό μοντέλο ενσωμάτωσης, οπότε η Βάση γνώσεων δεν μπορεί να ευρετηριάσει κείμενο εδώ."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limba acestui dispozitiv nu are un model local de încorporare, deci Baza de cunoștințe nu poate indexa textul aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для языка этого устройства нет локальной модели эмбеддингов, поэтому база знаний не может индексировать текст здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备的语言没有本地嵌入模型，因此知识库无法在这里为文本建立索引。"
          }
        },
        "ko" : {
