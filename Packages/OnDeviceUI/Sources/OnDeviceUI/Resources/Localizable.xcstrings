    "Still working on your device. You can stop at any time." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verarbeitung läuft auf deinem Gerät weiter. Du kannst jederzeit stoppen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue trabajando en tu dispositivo. Puedes detenerlo cuando quieras."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال يعمل على جهازك. يمكنك إيقافه في أي وقت."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazınızda çalışmaya devam ediyor. İstediğiniz zaman durdurabilirsiniz."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी भी आपके डिवाइस पर काम हो रहा है। आप कभी भी रोक सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上で処理中です。いつでも停止できます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours en cours sur votre appareil. Vous pouvez arrêter à tout moment."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda processando no seu dispositivo. Você pode parar a qualquer momento."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elaborazione ancora in corso sul tuo dispositivo. Puoi interrompere in qualsiasi momento."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επεξεργασία συνεχίζεται στη συσκευή σας. Μπορείτε να τη διακόψετε ανά πάσα στιγμή."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă se lucrează pe dispozitivul dvs. Puteți opri oricând."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работа на вашем устройстве продолжается. Остановить можно в любой момент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍在你的设备上处理。你可以随时停止。"
          }
        },
        "ko" : {
