        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimina la imagen de Token AI. Las copias exportadas a Fotos u otras apps se conservan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف الصورة من Token AI. تبقى النسخ التي صدّرتها إلى الصور أو تطبيق آخر."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görsel Token AI'tan kaldırılır. Fotoğraflar'a veya başka uygulamaya aktardığınız kopyalar kalır."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह छवि Token AI से हटाता है। फ़ोटो या अन्य ऐप में निर्यात की गई प्रतियाँ बनी रहती हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AIから画像を削除します。写真やほかのアプリに書き出したコピーは残ります。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime l'image de Token AI. Les copies exportées vers Photos ou une autre app y restent."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove a imagem do Token AI. As cópias exportadas para o Fotos ou outro app permanecem lá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove l'immagine da Token AI. Le copie esportate in Foto o in un'altra app restano lì."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί την εικόνα από το Token AI. Τα αντίγραφα που εξαγάγατε στις Φωτογραφίες ή σε άλλη εφαρμογή παραμένουν εκεί."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta elimină imaginea din Token AI. Copiile exportate în Poze sau în altă aplicație rămân acolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображение будет удалено из Token AI. Копии, экспортированные в «Фото» или другое приложение, останутся там."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从 Token AI 中移除该图片。你导出到“照片”或其他应用的副本仍会保留。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI에서 이미지가 제거됩니다. 사진이나 다른 앱으로 내보낸 사본은 그대로 남습니다."
          }
        }
      },
