          }
        }
      },
      "generatesSymbol" : false
    },
    "This frees up disk space. The model can be downloaded again later." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu disk alanı boşaltır. Model daha sonra tekrar indirilebilir."
