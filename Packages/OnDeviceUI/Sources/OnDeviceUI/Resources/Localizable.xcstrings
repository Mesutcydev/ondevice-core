    "Start your first chat, explore each workspace, and learn where your content goes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte deinen ersten Chat, entdecke jeden Arbeitsbereich und erfahre, wohin deine Inhalte gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza tu primer chat, explora cada espacio de trabajo y descubre adónde va tu contenido."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ أول محادثة، واستكشف كل مساحة عمل، وتعرّف على وجهة محتواك."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk sohbetinizi başlatın, her çalışma alanını keşfedin ve içeriğinizin nereye gittiğini öğrenin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी पहली चैट शुरू करें, हर वर्कस्पेस देखें और जानें कि आपकी सामग्री कहाँ जाती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のチャットを始め、各ワークスペースを見て、コンテンツがどこへ送られるかを確認しましょう。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez votre première discussion, explorez chaque espace de travail et découvrez où va votre contenu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece seu primeiro chat, explore cada área de trabalho e saiba para onde vai o seu conteúdo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia la tua prima chat, esplora ogni area di lavoro e scopri dove vanno i tuoi contenuti."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε την πρώτη σας συζήτηση, εξερευνήστε κάθε χώρο εργασίας και μάθετε πού πηγαίνει το περιεχόμενό σας."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Începeți prima conversație, explorați fiecare spațiu de lucru și aflați unde ajunge conținutul dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните первый чат, изучите каждое рабочее пространство и узнайте, куда попадает ваше содержимое."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始你的第一个聊天，探索各个工作区，并了解你的内容会去往哪里。"
          }
        },
        "ko" : {
          "stringUnit" : {
