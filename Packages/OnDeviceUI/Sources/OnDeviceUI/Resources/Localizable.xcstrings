    "HTTP traffic is not encrypted. Start the server only on a trusted local network." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP-Verkehr ist unverschlüsselt. Starte den Server nur in einem vertrauenswürdigen lokalen Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tráfico HTTP no está cifrado. Inicia el servidor solo en una red local de confianza."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حركة HTTP غير مشفّرة. شغّل الخادم على شبكة محلية موثوقة فقط."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP trafiği şifrelenmez. Sunucuyu yalnızca güvendiğiniz yerel ağda başlatın."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP ट्रैफ़िक एन्क्रिप्टेड नहीं है। सर्वर केवल विश्वसनीय स्थानीय नेटवर्क पर शुरू करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP通信は暗号化されません。信頼できるローカルネットワークでのみ起動してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trafic HTTP n'est pas chiffré. Ne démarrez le serveur que sur un réseau local de confiance."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tráfego HTTP não é criptografado. Inicie o servidor apenas em uma rede local confiável."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il traffico HTTP non è crittografato. Avvia il server solo su una rete locale attendibile."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κίνηση HTTP δεν είναι κρυπτογραφημένη. Ξεκινήστε τον διακομιστή μόνο σε αξιόπιστο τοπικό δίκτυο."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traficul HTTP nu este criptat. Porniți serverul doar într-o rețea locală de încredere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
