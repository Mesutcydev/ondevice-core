    "Voice answer off. Tap to let the assistant speak." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli yanıt kapalı. Konuşmasına izin vermek için dokunun."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachantwort aus. Zum Sprechen tippen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponse vocale désactivée. Appuyez pour laisser l'assistant parler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respuesta de voz desactivada. Toque para dejar hablar al asistente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risposta vocale spenta. Tocca per far parlare l'assistente."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resposta de voz desligada. Toque para permitir que o assistente fale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосовой ответ выкл. Нажмите, чтобы ассистент говорил."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवाज़ उत्तर बंद। असिस्टेंट को बोलने देने के लिए टैप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声応答オフ。タップでアシスタントが発話。"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποίηση φωνητικής απάντησης. Πατήστε για να αφήσετε τον βοηθό να μιλήσει."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Răspuns cu voce oprită. Atingeți pentru a permite asistentului să vorbească."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرد الصوتي متوقف. انقر للسماح للمساعد بالتحدث."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 응답 꺼짐. 탭하여 어시스턴트가 말하게 함."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音回答已关闭。点击让助手说话。"
          }
        }
      },
      "generatesSymbol" : false
    },
