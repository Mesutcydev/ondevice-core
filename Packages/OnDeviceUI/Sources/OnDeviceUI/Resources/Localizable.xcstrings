            "state" : "translated",
            "value" : "Erstellt einen Commit zur Wiederherstellung des früheren Dateibaums. Der Verlauf bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un commit que restaura el árbol anterior. Conserva el historial."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف تثبيتًا يعيد شجرة الملفات السابقة ويحافظ على السجل."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
