    "Both are large downloads, and performance varies by device." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلاهما تنزيل كبير، ويختلف الأداء حسب الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide sind große Downloads, und die Leistung hängt vom Gerät ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas son descargas grandes y el rendimiento varía según el dispositivo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों बड़े डाउनलोड हैं, और प्रदर्शन डिवाइस के अनुसार बदलता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらも大容量のダウンロードで、性能はデバイスによって異なります。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkisi de büyük indirmelerdir ve performans cihaza göre değişir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux sont des téléchargements volumineux, et les performances varient selon l'appareil."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos são downloads grandes, e o desempenho varia conforme o dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi sono download di grandi dimensioni e le prestazioni variano in base al dispositivo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και τα δύο είναι μεγάλες λήψεις και η απόδοση διαφέρει ανά συσκευή."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambele sunt descărcări mari, iar performanța variază în funcție de dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обе загрузки большие, а производительность зависит от устройства."
