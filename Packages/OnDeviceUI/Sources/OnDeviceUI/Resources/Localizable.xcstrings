    "When selected, the conversation content needed for your request is sent to Apple Private Cloud Compute for processing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Auswahl wird der erforderliche Gesprächsinhalt zur Verarbeitung an Apple Private Cloud Compute gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al seleccionarlo se envía el contenido necesario de la conversación a Apple Private Cloud Compute para procesarlo."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الاختيار يُرسل محتوى المحادثة اللازم لطلبك إلى Apple Private Cloud Compute للمعالجة."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçildiğinde isteğiniz için gereken sohbet içeriği, işlenmek üzere Apple Private Cloud Compute'a gönderilir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनने पर अनुरोध के लिए आवश्यक बातचीत Apple Private Cloud Compute को संसाधन के लिए भेजी जाती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択すると、リクエストに必要な会話の内容をApple Private Cloud Computeに送信して処理します。"
          }
        }
      },
      "generatesSymbol" : false
    },
    "When you send a message, conversation text, system instructions, tool results, attached file excerpts, and supported images included in the request will be sent to this endpoint." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Senden werden Gesprächsinhalt, Systemanweisungen, Werkzeugergebnisse, Dateiauszüge und unterstützte Bilder aus der Anfrage an diesen Endpunkt übertragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al enviar un mensaje se envían a este endpoint el texto, las instrucciones del sistema, los resultados de herramientas, los extractos y las imágenes incluidas."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إرسال رسالة، تُرسل نصوص المحادثة وتعليمات النظام ونتائج الأدوات ومقتطفات الملفات والصور المدعومة المتضمنة في الطلب إلى نقطة النهاية هذه."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesaj gönderdiğinizde istekte yer alan sohbet metni, sistem talimatları, araç sonuçları, dosya alıntıları ve desteklenen görseller bu uç noktaya gönderilir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संदेश भेजने पर अनुरोध में शामिल बातचीत, सिस्टम निर्देश, टूल परिणाम, फ़ाइल अंश और समर्थित छवियाँ इस एंडपॉइंट पर भेजी जाती हैं।"
          }
        },
        "ja" : {
