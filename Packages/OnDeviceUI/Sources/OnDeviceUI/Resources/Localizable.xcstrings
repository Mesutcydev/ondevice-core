    "2–20 options, one per line: ID: description. IDs must be unique; descriptions can be up to 48 tokens." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2–20 Optionen, eine pro Zeile: ID: Beschreibung. IDs müssen eindeutig sein; Beschreibungen dürfen bis zu 48 Token enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 2 a 20 opciones, una por línea: ID: descripción. Los ID deben ser únicos; hasta 48 tokens por descripción."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من 2 إلى 20 خيارًا، واحد بكل سطر: المعرّف: الوصف. يجب أن تكون المعرّفات فريدة؛ والوصف حتى 48 رمزًا."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2–20 seçenek, her satıra bir tane: kimlik: açıklama. Kimlikler benzersiz olmalı; açıklamalar en fazla 48 belirteç olabilir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2–20 विकल्प, हर पंक्ति में एक: ID: विवरण। ID अद्वितीय हों; विवरण अधिकतम 48 टोकन हो सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2〜20個の選択肢を「ID: 説明」の形式で1行に1つ入力します。IDは重複不可、説明は48トークンまでです。"
          }
        }
      },
      "generatesSymbol" : false
    },
