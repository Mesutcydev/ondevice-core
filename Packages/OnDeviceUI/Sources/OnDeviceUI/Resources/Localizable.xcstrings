    },
    "Token AI combines local models with optional API providers, web access, Apple Private Cloud Compute, and paired Mac tools. Each network feature is controlled separately." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI kombiniert lokale Modelle mit optionalen API-Anbietern, Webzugriff, Apple Private Cloud Compute und gekoppelten Mac-Werkzeugen. Jede Netzwerkfunktion wird einzeln gesteuert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI combina modelos locales con proveedores API opcionales, acceso web, Apple Private Cloud Compute y herramientas de Mac enlazadas. Cada función de red se controla por separado."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع Token AI بين النماذج المحلية ومزوّدي API الاختياريين والوصول للويب وApple Private Cloud Compute وأدوات Mac المقترنة. يمكن التحكم بكل ميزة شبكة على حدة."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI; yerel modelleri, isteğe bağlı API sağlayıcıları, web erişimi, Apple Private Cloud Compute ve eşlenmiş Mac araçlarıyla birleştirir. Her ağ özelliği ayrı yönetilir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AI स्थानीय मॉडल के साथ वैकल्पिक API प्रदाता, वेब एक्सेस, Apple Private Cloud Compute और जुड़े Mac टूल जोड़ता है। हर नेटवर्क सुविधा अलग नियंत्रित होती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token AIはローカルモデルに加え、任意のAPIプロバイダー、ウェブアクセス、Apple Private Cloud Compute、ペアリングしたMacのツールに対応します。各ネットワーク機能は個別に管理できます。"
          }
        }
      },
      "generatesSymbol" : false
    },
