    "Sends your token with HF requests. Turn off temporarily to debug 401s without removing the token." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet deinen Token bei HF-Anfragen. Zum Prüfen von 401-Fehlern vorübergehend deaktivieren, ohne den Token zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía tu token en las solicitudes a HF. Desactívalo temporalmente para depurar errores 401 sin eliminar el token."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل رمزك مع طلبات HF. عطّله مؤقتًا لتشخيص أخطاء 401 دون حذف الرمز."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF istekleriyle belirtecinizi gönderir. Belirteci silmeden 401 hatalarını incelemek için geçici olarak kapatın."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF अनुरोधों के साथ आपका टोकन भेजता है। टोकन हटाए बिना 401 त्रुटियाँ जाँचने के लिए अस्थायी रूप से बंद करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HFへのリクエストにトークンを添付します。トークンを削除せず401エラーを調べるには一時的にオフにしてください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie votre jeton avec les requêtes HF. Désactivez temporairement pour déboguer les erreurs 401 sans supprimer le jeton."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia seu token com as solicitações ao HF. Desative temporariamente para depurar erros 401 sem remover o token."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia il tuo token con le richieste a HF. Disattiva temporaneamente per eseguire il debug degli errori 401 senza rimuovere il token."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στέλνει το token σας με τα αιτήματα προς το HF. Απενεργοποιήστε το προσωρινά για να διερευνήσετε σφάλματα 401 χωρίς να αφαιρέσετε το token."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimite tokenul dvs. cu solicitările către HF. Dezactivați temporar pentru a depana erorile 401 fără a elimina tokenul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет ваш токен с запросами к HF. Временно отключите, чтобы отладить ошибки 401, не удаляя токен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随 HF 请求发送你的令牌。可暂时关闭以排查 401 错误，而无需移除令牌。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF 요청에 토큰을 함께 보냅니다. 토큰을 제거하지 않고 401 오류를 디버그하려면 잠시 끄세요."
          }
        }
      },
      "generatesSymbol" : false
    },
