    "tip: a smaller model (≤1.5B) keeps the back-and-forth snappy and avoids overheating during long voice sessions." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ipucu: daha küçük bir model (≤1.5B) konuşmayı hızlı tutar ve uzun ses oturumlarında ısınmayı önler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Ein kleineres Modell (≤1,5B) hält den Austausch flott und vermeidet Überhitzung bei langen Sprachsitzungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "astuce : un modèle plus petit (≤1,5B) garde les échanges rapides et évite la surchauffe lors de longues sessions vocales."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "consejo: un modelo más pequeño (≤1.5B) mantiene el intercambio ágil y evita el sobrecalentamiento en sesiones de voz largas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "suggerimento: un modello più piccolo (≤1.5B) mantiene lo scambio rapido ed evita il surriscaldamento durante sessioni vocali lunghe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dica: um modelo menor (≤1.5B) mantém a conversa ágil e evita superaquecimento durante sessões de voz longas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "совет: меньшая модель (≤1.5B) делает обмен быстрым и избегает перегрева при долгих голосовых сессиях."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुझाव: छोटा मॉडल (≤1.5B) बातचीत को तेज़ रखता है और लंबी आवाज़ सत्रों में गर्मी से बचाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：小さめのモデル（≤1.5B）はやり取りを軽快にし、長時間の音声セッションでの過熱を防ぎます。"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "συμβουλή: ένα μικρότερο μοντέλο (≤1,5B) κρατά την κίνηση εμπρός-πίσω και αποτρέπει την υπερθέρμανση κατά τη διάρκεια μεγάλων συνεδριών φωνής."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sfat: un model mai mic (≤1,5B) menține rapid înainte și înapoi și evită supraîncălzirea în timpul sesiunilor lungi de voce."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصيحة: نموذج أصغر (≤1.5B) يحافظ على سرعة التبادل ويتجنب ارتفاع الحرارة أثناء جلسات الصوت الطويلة."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 작은 모델(≤1.5B)은 대화를 빠르게 유지하고 긴 음성 세션 중 과열을 방지합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：较小的模型（≤1.5B）可保持对话流畅，并避免长时间语音会话中过热。"
          }
        }
      },
      "generatesSymbol" : false
    },
