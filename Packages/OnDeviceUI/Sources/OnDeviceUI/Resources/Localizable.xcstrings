    "When selected, the conversation content needed for your request is sent to Apple Private Cloud Compute for processing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Auswahl wird der erforderliche Gesprächsinhalt zur Verarbeitung an Apple Private Cloud Compute gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al seleccionarlo se envía el contenido necesario de la conversación a Apple Private Cloud Compute para procesarlo."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الاختيار يُرسل محتوى المحادثة اللازم لطلبك إلى Apple Private Cloud Compute للمعالجة."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçildiğinde isteğiniz için gereken sohbet içeriği, işlenmek üzere Apple Private Cloud Compute'a gönderilir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनने पर अनुरोध के लिए आवश्यक बातचीत Apple Private Cloud Compute को संसाधन के लिए भेजी जाती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択すると、リクエストに必要な会話の内容をApple Private Cloud Computeに送信して処理します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est sélectionnée, le contenu de la conversation nécessaire à votre demande est envoyé à Apple Private Cloud Compute pour traitement."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando selecionado, o conteúdo da conversa necessário para o seu pedido é enviado ao Apple Private Cloud Compute para processamento."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se selezionato, il contenuto della conversazione necessario per la tua richiesta viene inviato ad Apple Private Cloud Compute per l'elaborazione."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν επιλεγεί, το περιεχόμενο της συνομιλίας που χρειάζεται για το αίτημά σας στέλνεται στο Apple Private Cloud Compute για επεξεργασία."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este selectat, conținutul conversației necesar solicitării dvs. este trimis către Apple Private Cloud Compute pentru procesare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выбрано, содержимое разговора, необходимое для вашего запроса, отправляется на обработку в Apple Private Cloud Compute."
