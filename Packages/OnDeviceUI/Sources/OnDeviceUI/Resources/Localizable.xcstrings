    "GitHub's authorization page names SiteAgent, the sign-in registration shared by these apps. TokenAI stores its own token separately." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubs Autorisierungsseite zeigt SiteAgent, die gemeinsame Anmelderegistrierung dieser Apps. TokenAI speichert seinen Token separat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La página de autorización de GitHub muestra SiteAgent, el registro de acceso compartido por estas apps. TokenAI guarda su propio token por separado."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُظهر صفحة تفويض GitHub اسم SiteAgent، وهو تسجيل الدخول المشترك بين هذه التطبيقات. يخزّن TokenAI رمزه الخاص منفصلًا."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub yetkilendirme sayfası, bu uygulamaların ortak oturum kaydı olan SiteAgent adını gösterir. TokenAI kendi belirtecini ayrı saklar."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub अनुमति पृष्ठ पर इन ऐप के साझा साइन-इन पंजीकरण SiteAgent का नाम दिखता है। TokenAI अपना टोकन अलग सहेजता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubの認証画面には、これらのアプリで共有するサインイン登録名SiteAgentが表示されます。TokenAIのトークンは個別に保存します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page d'autorisation de GitHub mentionne SiteAgent, l'enregistrement de connexion partagé par ces apps. TokenAI stocke son propre jeton séparément."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A página de autorização do GitHub menciona SiteAgent, o registro de login compartilhado por estes apps. O TokenAI guarda seu próprio token separadamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pagina di autorizzazione di GitHub indica SiteAgent, la registrazione di accesso condivisa da queste app. TokenAI conserva il proprio token separatamente."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σελίδα εξουσιοδότησης του GitHub αναφέρει το SiteAgent, την κοινή εγγραφή σύνδεσης αυτών των εφαρμογών. Το TokenAI αποθηκεύει το δικό του token ξεχωριστά."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagina de autorizare GitHub menționează SiteAgent, înregistrarea de autentificare partajată de aceste aplicații. TokenAI își păstrează separat propriul token."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На странице авторизации GitHub указан SiteAgent — общая регистрация входа для этих приложений. TokenAI хранит свой токен отдельно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 的授权页面会显示 SiteAgent，这是这些应用共用的登录注册名。TokenAI 会单独存储自己的令牌。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 인증 페이지에는 이 앱들이 공유하는 로그인 등록 이름인 SiteAgent가 표시됩니다. TokenAI는 자체 토큰을 따로 저장합니다."
          }
        }
      },
      "generatesSymbol" : false
    },
    "Go ahead, I’m listening." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich ruhig, ich höre zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adelante, te escucho."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفضل، أنا أستمع."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buyurun, dinliyorum."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलिए, मैं सुन रहा हूँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どうぞ、お話しください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allez-y, je vous écoute."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode falar, estou ouvindo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parla pure, ti ascolto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε μου, σας ακούω."
          }
        },
        "ro" : {
