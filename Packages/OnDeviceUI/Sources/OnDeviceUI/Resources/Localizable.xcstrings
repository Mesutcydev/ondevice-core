          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछला फ़ाइल ट्री बहाल करने वाला कमिट जोड़ता है। इतिहास बना रहता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のファイル構成に戻すコミットを追加します。履歴は保持します。"
          }
        },
        "fr" : {
          "stringUnit" : {
