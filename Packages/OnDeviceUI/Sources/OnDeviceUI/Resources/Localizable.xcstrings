        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデル → ダウンロードセンターでQwen3-VL、Gemma 3 Vision、SmolVLM2などを閲覧。ダウンロード完了時に選択肢が自動更新されます。"
          }
        },
        "el" : {
          "stringUnit" : {
