    "Image understanding with experts streamed from storage. Needs 12 GB of RAM and about 35 GB free." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهم الصور مع بثّ الخبراء من التخزين. يتطلب 12 GB من ذاكرة RAM ونحو 35 GB من المساحة الفارغة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildverständnis mit Experten, die aus dem Speicher gestreamt werden. Benötigt 12 GB RAM und etwa 35 GB freien Speicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprensión de imágenes con expertos transmitidos desde el almacenamiento. Requiere 12 GB de RAM y unos 35 GB libres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टोरेज से स्ट्रीम किए गए एक्सपर्ट्स के साथ इमेज समझ। 12 GB RAM और लगभग 35 GB खाली जगह चाहिए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エキスパートをストレージから読み込む画像理解。12 GBのRAMと約35 GBの空き容量が必要です。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzmanları depolamadan aktarılan görüntü anlama. 12 GB RAM ve yaklaşık 35 GB boş alan gerekir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compréhension d'images avec des experts chargés en continu depuis le stockage. Nécessite 12 Go de RAM et environ 35 Go libres."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compreensão de imagens com especialistas transmitidos do armazenamento. Requer 12 GB de RAM e cerca de 35 GB livres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprensione delle immagini con esperti caricati in streaming dallo spazio di archiviazione. Richiede 12 GB di RAM e circa 35 GB liberi."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατανόηση εικόνων με ειδικούς που φορτώνονται σταδιακά από τον αποθηκευτικό χώρο. Χρειάζεται 12 GB RAM και περίπου 35 GB ελεύθερα."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înțelegerea imaginilor cu experți transmiși din stocare. Necesită 12 GB de RAM și aproximativ 35 GB liberi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понимание изображений с экспертами, подгружаемыми из хранилища. Требуется 12 ГБ ОЗУ и около 35 ГБ свободного места."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像理解，专家模块从存储空间流式加载。需要 12 GB 内存和约 35 GB 可用空间。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장 공간에서 전문가를 스트리밍하는 이미지 이해 모델. RAM 12GB와 여유 공간 약 35GB가 필요합니다."
          }
        }
      }
    },
