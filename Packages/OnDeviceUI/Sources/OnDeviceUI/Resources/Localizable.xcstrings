    "Saves the instructions and labels on this device. Input text and photos are kept out of the saved task." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert Anweisungen und Labels auf diesem Gerät. Eingabetext und Fotos werden nicht in der Aufgabe gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda las instrucciones y etiquetas en este dispositivo. La tarea no incluye el texto de entrada ni las fotos."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ التعليمات والتسميات على هذا الجهاز. لا تتضمن المهمة المحفوظة نص الإدخال أو الصور."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talimat ve etiketleri bu cihazda kaydeder. Girdi metni ve fotoğraflar kayıtlı göreve eklenmez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्देश और लेबल इसी डिवाइस पर सहेजता है। इनपुट पाठ और फ़ोटो सहेजे गए कार्य में शामिल नहीं होते।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指示とラベルをこのデバイスに保存します。入力テキストや写真はタスクに含めません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre les instructions et les étiquettes sur cet appareil. Le texte saisi et les photos ne sont pas inclus dans la tâche enregistrée."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva as instruções e os rótulos neste dispositivo. O texto de entrada e as fotos ficam fora da tarefa salva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva le istruzioni e le etichette su questo dispositivo. Il testo di input e le foto restano fuori dall'attività salvata."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύει τις οδηγίες και τις ετικέτες σε αυτήν τη συσκευή. Το κείμενο εισόδου και οι φωτογραφίες δεν περιλαμβάνονται στην αποθηκευμένη εργασία."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvează instrucțiunile și etichetele pe acest dispozitiv. Textul introdus și pozele nu sunt incluse în sarcina salvată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет инструкции и метки на этом устройстве. Введённый текст и фото в сохранённую задачу не попадают."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将说明和标签存储在此设备上。输入的文本和照片不会包含在已存储的任务中。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지침과 레이블을 이 기기에 저장합니다. 입력 텍스트와 사진은 저장된 작업에 포함되지 않습니다."
          }
        }
      },
      "generatesSymbol" : false
    },
