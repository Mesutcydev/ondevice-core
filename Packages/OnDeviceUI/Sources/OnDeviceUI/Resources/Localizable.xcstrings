    "Models marked Keep stay on this device. Removed models can be downloaded again later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Behalten“ markierte Modelle bleiben auf diesem Gerät. Entfernte Modelle lassen sich später erneut laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos marcados como Conservar permanecen en este dispositivo. Los modelos quitados se pueden descargar de nuevo más tarde."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى النماذج المعلَّمة بـ «إبقاء» على هذا الجهاز. يمكن تنزيل النماذج المُزالة مرة أخرى لاحقًا."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakla olarak işaretlenen modeller bu cihazda kalır. Kaldırılan modeller daha sonra yeniden indirilebilir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“रखें” के रूप में चिह्नित मॉडल इस डिवाइस पर बने रहते हैं। हटाए गए मॉडल बाद में फिर से डाउनलोड किए जा सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「保持」にしたモデルはこのデバイスに残ります。削除したモデルは、あとでもう一度ダウンロードできます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles marqués Garder restent sur cet appareil. Les modèles supprimés pourront être téléchargés à nouveau plus tard."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelos marcados como Manter permanecem neste dispositivo. Modelos removidos podem ser baixados novamente depois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I modelli contrassegnati come Mantieni restano su questo dispositivo. I modelli rimossi possono essere scaricati di nuovo più tardi."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μοντέλα που έχουν επισημανθεί ως Διατήρηση παραμένουν σε αυτήν τη συσκευή. Τα μοντέλα που καταργούνται μπορούν να ληφθούν ξανά αργότερα."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelele marcate cu Păstrați rămân pe acest dispozitiv. Modelele eliminate pot fi descărcate din nou mai târziu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели с пометкой «Оставить» остаются на этом устройстве. Удалённые модели можно скачать снова позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记为“保留”的模型会留在此设备上。移除的模型之后可以再次下载。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘유지’로 표시한 모델은 이 기기에 남습니다. 제거한 모델은 나중에 다시 다운로드할 수 있습니다."
          }
        }
      },
      "generatesSymbol" : false
    },
