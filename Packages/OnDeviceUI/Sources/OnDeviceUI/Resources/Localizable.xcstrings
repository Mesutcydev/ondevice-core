    "Off uses the app-wide Assistant settings. Turn it on to save an independent profile for this model." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus verwendet die allgemeinen Assistenteneinstellungen. Aktiviere die Option für ein eigenes Modellprofil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado usa los ajustes generales del asistente. Actívalo para guardar un perfil independiente del modelo."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التعطيل تُستخدم إعدادات المساعد العامة. فعّله لحفظ ملف مستقل لهذا النموذج."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken genel Asistan ayarları kullanılır. Bu modele özel profil kaydetmek için açın."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद होने पर ऐप के सामान्य सहायक सेटिंग उपयोग होते हैं। मॉडल की स्वतंत्र प्रोफ़ाइल सहेजने के लिए चालू करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフではアシスタントの共通設定を使います。オンにするとモデル専用のプロファイルを保存できます。"
          }
        }
      },
      "generatesSymbol" : false
    },
