    "Deletes downloaded models, conversations, snippets, memories, saved API keys, GitHub credentials, Mac Bridge pairings, cache, and resets onboarding. Cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht heruntergeladene Modelle, Unterhaltungen, Textbausteine, Erinnerungen, gespeicherte API-Schlüssel, GitHub-Zugangsdaten, Mac-Bridge-Kopplungen und Cache und setzt die Einführung zurück. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina modelos descargados, conversaciones, fragmentos, recuerdos, claves API, credenciales de GitHub, enlaces con Mac Bridge y caché, y reinicia la configuración inicial. No se puede deshacer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف النماذج المنزّلة والمحادثات والمقتطفات والذكريات ومفاتيح API المحفوظة وبيانات GitHub واقترانات Mac Bridge والذاكرة المؤقتة ويعيد إعداد البدء. لا يمكن التراجع."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen modelleri, sohbetleri, parçacıkları, anıları, API anahtarlarını, GitHub kimlik bilgilerini, Mac Bridge eşlemelerini ve önbelleği siler; başlangıç kurulumunu sıfırlar. Geri alınamaz."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड किए गए मॉडल, बातचीत, स्निपेट, यादें, सहेजी गई API कुंजियाँ, GitHub क्रेडेंशियल, Mac Bridge पेयरिंग और कैश मिटाता है तथा शुरुआती सेटअप रीसेट करता है। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みモデル、会話、スニペット、メモリ、APIキー、GitHub認証情報、Mac Bridgeのペアリング、キャッシュを削除し、初回設定をリセットします。取り消せません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les modèles téléchargés, les conversations, les extraits, les souvenirs, les clés API enregistrées, les identifiants GitHub, les jumelages Mac Bridge et le cache, et réinitialise l'introduction. Action irréversible."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui modelos baixados, conversas, trechos, memórias, chaves de API salvas, credenciais do GitHub, pareamentos do Mac Bridge e o cache, e redefine a introdução. Não pode ser desfeito."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina modelli scaricati, conversazioni, snippet, ricordi, chiavi API salvate, credenziali GitHub, abbinamenti Mac Bridge e cache, e ripristina l'introduzione. L'operazione non può essere annullata."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφει ληφθέντα μοντέλα, συνομιλίες, αποσπάσματα, αναμνήσεις, αποθηκευμένα κλειδιά API, διαπιστευτήρια GitHub, ζεύξεις Mac Bridge και την cache, και επαναφέρει την εισαγωγή. Δεν είναι δυνατή η αναίρεση."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Șterge modelele descărcate, conversațiile, fragmentele, amintirile, cheile API salvate, datele de autentificare GitHub, asocierile Mac Bridge și memoria cache și resetează introducerea. Acțiunea nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет скачанные модели, разговоры, сниппеты, воспоминания, сохранённые ключи API, учётные данные GitHub, сопряжения Mac Bridge и кэш, а также сбрасывает вводные экраны. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除已下载的模型、对话、片段、记忆、已存储的 API 密钥、GitHub 凭证、Mac Bridge 配对和缓存，并重置新手引导。此操作无法撤销。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 모델, 대화, 스니펫, 기억, 저장된 API 키, GitHub 자격 증명, Mac Bridge 페어링, 캐시를 삭제하고 온보딩을 재설정합니다. 실행 취소할 수 없습니다."
          }
        }
      },
      "generatesSymbol" : false
    },
